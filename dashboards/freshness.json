          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(retina_adsb_provider_record_delay_seconds_bucket{provider=\"adsbhub\"}[5m])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
